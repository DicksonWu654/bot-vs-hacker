_up":{"builder":"Titan (titanbuilder.xyz)","eth":0.229707,"t_ms":1273}},"bot_idx":0,"atk_idx":null,"atk_block":null,"blocks_ahead":null,"attacker_seen_rel_ms":null,"reaction":null,"events":[{"t":1760012963000,"utc":"2025-10-09T12:29:23Z","prec":null,"kind":"block","actor":"Yoink","detail":"Yoink sweeps the stranded USDC at idx 0 of block 23540182; coinbase 1.8048 ETH, builder refund 1.5725 ETH","tx":"0xe00aea94c4f9374f1a005a9f5832f0d36b3e8cd1f6f5407ee6cb629461ecbbde","block":23540182,"raw":"raw/rpc/block_23540182.json","raws":["raw/rpc/block_23540182.json","raw/rpc/trace_block_23540182.json"],"raw_note":null,"derived":null},{"t":1760031983000,"utc":"2025-10-09T17:46:23Z","prec":null,"kind":"return","actor":"Yoink","detail":"returns 1.416285 ETH to the Peapods team ('Returning profits minus 10% bounty')","tx":"0xcd6d475f859cddeb637906c668dc616f1f470033bdb44f4b99c40eb84dacd3e6","block":23541758,"raw":"raw/etherscan/peap_peateam_txlist_22800000.json","raws":["raw/etherscan/peap_peateam_txlist_22800000.json"],"raw_note":null,"derived":null}],"fate":{"kind":"partial","text":"Peapods messaged Yoink on 2025-10-09 16:43:59Z (tx 0x0a5694d3, block 23541447: 'we see you were able to fetch the ~2 ETH leftover ... from a previous user's tx'). Yoink returned 1.416285 ETH at 17:46:23Z (tx 0xcd6d475f, block 23541758) with the message 'Returning profits minus 10% bounty': 90.00% of its 1.5736 ETH net.","returned_pct":78.394},"incident_raw":{"attacker_txlist":"raw/etherscan/peap_att_txlist.json","vault_tokentx":"raw/etherscan/peap_vault_tokentx_22874000_22960000.json","web":"raw/web-peapods/quadriga_peapods.html"},"timeline_notes":[],"sources":["https://quadrigainitiative.com/casestudy/peapodsfinanceasplongsusdepricemanipulationattack.php (saved raw/web-peapods/quadriga_peapods.html; quotes Phalcon: 'successfully executed the first exploit, but its second attempt was front-run by Yoink'; links tx 0xff8e9226 as 'Second Transaction Which Was Front-run')","https://app.blocksec.com/explorer/tx/eth/0xeff836fa1ce60f04b94544fa424764101323f1f7c8ab8265b4bd34e9fa84f8db","https://app.blocksec.com/explorer/tx/eth/0xff8e9226091d513fc936ecc670030eba03f34dbe60cd012122bd18be44248d32","https://thedefiant.io/news/defi/peapods-finance-token-slips-5-percent-on-reported-oracle-issue (saved; body truncated)"],"dataset_money":{"scope":"bot-tx","coinbase_eth":1.804825488667,"paid_to_builder_eth":1.804825488667,"builder_refund_eth":1.572455422953,"note":"Scope is the single Yoink tx. bot_net = gross - coinbase + builder refund - gas (0.000616 ETH at 0.294285336 gwei). The block has 3 txs: Yoink idx 0, the builder's refund idx 1 (1.5725 ETH to the bot contract) and the proposer payment idx 2. Coinbase msg.value 999 (per mille rule) = 1.8048 ETH; the refund returned most of it, so the bot ended with 1.5736 ETH. Gross is the measured ETH received by the bot contract in the trace (2.0406) minus the 0.2339 ETH the tx wrapped into WETH; Yoink's own return (1.416285 ETH) is exactly 90% of the net computed this way, which supports treating the wrapped amount as a cost. The ETH value of the 8,957.75 USDC is not separately priced."},"title":"Peapods: October leftover","sub_label":"October leftover","evidence_strength":"medium","evidence_strength_basis":"first-sweeper and return are on chain; whether Yoink saw the user's tx pending is unknown (neither tx in the mempool archive)","public_ordering":null,"comparison_policy":null,"caveat":null,"headline":false,"timeline_publication_gaps":[{"tx":"0x60b2c65c3fded55a34bde7b99f0b5e1ef9d7a91c5ad6afc31fcd29e15bf9c8f1","kind":"tx","unsupported_fields":["amount 8,957.75 USDC"]}]}